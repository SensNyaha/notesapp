# Copy to .env (ignored by Git); use only local values, never commit real secrets.
APP_ORIGIN=http://localhost:3100
AUTH_COOKIE_MODE=localhost
# Both empty: first administrator is created through the first login confirmation.
# Both supplied: server creates the first administrator before listening.
# Existing accounts are never changed by these variables.
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=
# On HTTPS, set the exact public origin and AUTH_COOKIE_MODE=secure.
# Remove bootstrap credentials after setup and recreate the container.
